generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions               Session[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
  loginAttempts          LoginAttempt[]
  tripMemberships        TripMembership[]
}

// Shape required by @auth/prisma-adapter's AdapterSession contract.
// Looked up by sessionToken, not id.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String
  succeeded Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, succeeded, createdAt])
}

model Trip {
  id         String    @id @default(cuid())
  name       String
  // A calendar date, not an instant — a trip starts on a day. @db.Date keeps
  // Postgres from storing a time component that a non-UTC server would shift
  // into the previous/next day. There is deliberately no endDate column: it's
  // derived from this date plus the sum of every stop's nights (#8) and is
  // undefined for a trip with no stops yet.
  startDate  DateTime  @db.Date
  // "USD" | "EUR" — see TRIP_CURRENCIES in src/lib/trips/constants.ts.
  currency   String
  // Null until the trip is marked finished. A bare stand-in for #16 (mark
  // trip finished), added early here only because #15 Phase 3's "Marcar
  // como saldada" gates on it — #16 hasn't shipped yet. #16's own plan owns
  // the real finish flow (the validation gate, the bulk cash-conversion
  // step); this column is just the flag they'll set.
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships      TripMembership[]
  invite           TripInvite?
  reservations     TripInviteReservation[]
  stops            TripStop[]
  settledTransfers SettledTransfer[]
}

model TripMembership {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  // "admin" (the creator) | "participant" — see TRIP_ROLES in src/lib/trips/constants.ts.
  role        String
  // Per-trip identity, deliberately separate from the account's own name and
  // avatar color — the same person can be "Ana" here and "Ana Pérez"
  // elsewhere, or a different color entirely on a different trip.
  displayName String
  colorIndex  Int
  createdAt   DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  claimedReservation         TripInviteReservation?
  bookingsReserved           Booking[]              @relation("BookingReservedBy")
  bookingsPaid               Booking[]              @relation("BookingPaidBy")
  bookingUsages              BookingUser[]
  expensesPaid               Expense[]              @relation("ExpensePaidBy")
  expenseUsages              ExpenseUser[]
  settledTransfersAsDebtor   SettledTransfer[]      @relation("SettledTransferDebtor")
  settledTransfersAsCreditor SettledTransfer[]      @relation("SettledTransferCreditor")

  @@unique([tripId, userId])
  @@index([userId])
}

// The trip's single shareable link, one row per trip — enforced by the plain
// unique index on tripId, so "one link per trip" is a DB constraint, not just
// a convention in code. The token is stored in plaintext (unlike
// PasswordResetToken's hash) because the invite panel has to redisplay the
// same link every time it's reopened (Phase 5's "Compartir" dialog).
model TripInvite {
  id        String   @id @default(cuid())
  tripId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// A pending crew slot reserved by email — not access control, and nothing is
// ever sent to the address. It only tracks who's expected, until that person
// joins through the trip's link and their account email claims this row.
model TripInviteReservation {
  id                    String    @id @default(cuid())
  tripId                String
  email                 String
  claimedAt             DateTime?
  claimedByMembershipId String?   @unique
  createdAt             DateTime  @default(now())

  trip                Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  claimedByMembership TripMembership? @relation(fields: [claimedByMembershipId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
}

// A stop in a trip's route — an ordered list of cities visited. Position is
// 1-based and reindexed when stops are removed. Dates are derived from the
// trip's startDate plus cumulative prior nights, never stored.
model TripStop {
  id            String   @id @default(cuid())
  tripId        String
  position      Int
  city          String
  country       String
  latitude      Float
  longitude     Float
  nights        Int      @default(1)
  status        String   @default("thinking")
  transportMode String?
  createdAt     DateTime @default(now())

  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places   TripPlace[]
  bookings Booking[]
  expenses Expense[]

  @@unique([tripId, position])
  @@index([tripId])
}

// A place marked in a stop's city — a hotel, excursion, landmark, or
// anything else the group wants pinned there. Belongs to the stop (a city
// instance), not a bare city name, so two visits to the same city (if that's
// ever possible) never share or leak each other's places (#10).
model TripPlace {
  id        String   @id @default(cuid())
  stopId    String
  label     String
  // "alojamiento" | "plan" | "idea" | "transporte" — see PLACE_KINDS in
  // src/lib/trips/constants.ts.
  kind      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  stop TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

// A confirmed booking — hotel, flight, activity, anything with a
// reservation — belonging to a stop, same as TripPlace (#10). #12's "whose
// name it's under" and #13's "who to ask to show the voucher" are the same
// field (reservedBy), matching the design's own voucher chip.
model Booking {
  id           String   @id @default(cuid())
  stopId       String
  label        String
  reservedById String
  paidById     String
  createdAt    DateTime @default(now())

  stop       TripStop       @relation(fields: [stopId], references: [id], onDelete: Cascade)
  reservedBy TripMembership @relation("BookingReservedBy", fields: [reservedById], references: [id])
  paidBy     TripMembership @relation("BookingPaidBy", fields: [paidById], references: [id])
  users      BookingUser[]
  vouchers   VoucherFile[]

  @@index([stopId])
}

// "Quién lo usa" — a many-to-many against trip members, not a fixed-size
// list; a booking can cover one person or the whole crew.
model BookingUser {
  id           String @id @default(cuid())
  bookingId    String
  membershipId String

  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  membership TripMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([bookingId, membershipId])
  @@index([membershipId])
}

// One uploaded file (PDF or image) attached to a booking, stored in Vercel
// Blob (ADR 0009) — only the resulting metadata lives here, never the
// bytes. A booking can have any number of these.
model VoucherFile {
  id        String   @id @default(cuid())
  bookingId String
  url       String
  filename  String
  mimeType  String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The client (after upload() resolves) and Blob's own onUploadCompleted
  // webhook can both race to persist the same upload — this constraint is
  // what makes addVoucherFile's upsert on (bookingId, url) safe instead of
  // occasionally creating a duplicate row for one file.
  @@unique([bookingId, url])
  @@index([bookingId])
}

// A logged expense, belonging to a stop like TripPlace (#10) and Booking
// (#12/#13). Deliberately not linked to a Booking (see #14's plan
// Non-goals) — the two stay independently-entered records even when one
// represents a booking's real cost.
model Expense {
  id               String   @id @default(cuid())
  stopId           String
  label            String
  // "transporte" | "alojamiento" | "comida" | "actividades" | "otro" — see
  // EXPENSE_CATEGORIES in src/lib/trips/constants.ts.
  category         String
  // "efectivo" | "tarjeta" — see PAYMENT_METHODS in constants.ts. Just a
  // label plus downstream routing for #16's finish-time behavior; nothing
  // in this ticket treats the two differently.
  paymentMethod    String
  // What was actually logged in the moment — kept around for reference,
  // never auto-converted.
  originalAmount   Float
  originalCurrency String
  // Null until the real statement amount is entered (Phase 4) — always in
  // the trip's own currency (Trip.currency) once set. A null adjustedAmount
  // is the "Pendiente de ajuste" state #15 later reads as provisional.
  adjustedAmount   Float?
  paidById         String
  createdAt        DateTime @default(now())

  stop   TripStop       @relation(fields: [stopId], references: [id], onDelete: Cascade)
  paidBy TripMembership @relation("ExpensePaidBy", fields: [paidById], references: [id])
  users  ExpenseUser[]

  @@index([stopId])
}

// "Quién lo usa" — a many-to-many against trip members, same shape as
// BookingUser (#12/#13); an expense can cover one person or the whole crew.
model ExpenseUser {
  id           String @id @default(cuid())
  expenseId    String
  membershipId String

  expense    Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  membership TripMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([expenseId, membershipId])
  @@index([membershipId])
}

// #15 Phase 3's one piece of real persisted state: which of Phase 1's
// computed transfers someone has actually paid. Identified by its own
// debtor/creditor/amount, not a foreign key to any stored transfer row —
// the transfer list itself is never stored, only recomputed fresh. A
// settled record survives a recomputation as long as the same triple still
// comes up; see getTripSettlement in src/lib/trips/settlement.ts for how a
// record that no longer matches anything live is surfaced as historical
// instead of silently dropped.
model SettledTransfer {
  id               String   @id @default(cuid())
  tripId           String
  fromMembershipId String
  toMembershipId   String
  amount           Float
  settledAt        DateTime @default(now())

  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromMembership TripMembership @relation("SettledTransferDebtor", fields: [fromMembershipId], references: [id], onDelete: Cascade)
  toMembership   TripMembership @relation("SettledTransferCreditor", fields: [toMembershipId], references: [id], onDelete: Cascade)

  @@unique([tripId, fromMembershipId, toMembershipId, amount])
  @@index([tripId])
}
